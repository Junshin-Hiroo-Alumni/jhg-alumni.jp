{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-20",
  "workers_dev": false,
  "preview_urls": false,
  "secrets": {
    "required": ["JWT_SECRET"]
  },
  "dev": {
    "port": 3001
  },
  "vars": {
    // 確認メールのリンク先。ローカル開発では dev スクリプトの --var で上書きする
    "SITE_URL": "https://jhg-alumni.jp",
    "MAIL_FROM": "noreply@jhg-alumni.jp",
    // "console" にすると送信せず、リンクをログに出す（ローカル開発用）
    "MAIL_DELIVERY": "cloudflare"
  },
  "send_email": [{ "name": "EMAIL" }],
  "ratelimits": [
    // 認証コードの総当たり対策（IP ごと）
    {
      "name": "CODE_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 }
    },
    // パスワードの総当たり対策（IP ごと）
    {
      "name": "LOGIN_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 10, "period": 60 }
    },
    // パスワード再設定メールの連続送信対策（IP ごと）
    {
      "name": "RESET_RATE_LIMITER",
      "namespace_id": "1003",
      "simple": { "limit": 5, "period": 60 }
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "jhg-alumni",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true
  }
}
