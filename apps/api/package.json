{
  "name": "@repo/api",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "dev": "pnpm run db:migrate && CLOUDFLARE_DEV_REGISTRY_PATH=../../.wrangler/dev-registry wrangler dev --var SITE_URL:http://localhost:3000 --var MAIL_DELIVERY:console",
    "deploy": "wrangler deploy --minify",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings --strict-vars false",
    "typecheck": "CI=1 pnpm run cf-typegen && tsc",
    "check-types": "pnpm run typecheck",
    "clean": "pnpm exec rimraf .turbo dist",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "CI=1 wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "roster:import": "node scripts/import-roster.ts"
  },
  "dependencies": {
    "@hono/swagger-ui": "^0.5.2",
    "@hono/zod-openapi": "^1.6.3",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.8"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.11",
    "wrangler": "^4.143.0"
  }
}
