{
  "name": "@repo/api",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "dev": "bun --hot src/index.ts",
    "clean": "pnpm exec rimraf .turbo",
    "check-types": "pnpm exec tsc -p tsconfig.json --noEmit --pretty false"
  },
  "dependencies": {
    "hono": "^4.12.8"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "devEngines": {
    "runtime": {
      "name": "bun",
      "version": "1.3.9",
      "onFail": "download"
    }
  }
}
