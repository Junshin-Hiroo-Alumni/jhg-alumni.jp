    "date-fns": "^4.4.0",
    "hono": "^4.13.8",
    "react": "^19.2.4",
    "takumi-js": "^2.14.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "wrangler": "^4.160.0"
  }
}
