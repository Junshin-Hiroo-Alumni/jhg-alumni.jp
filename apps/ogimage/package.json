{
  "name": "@repo/ogimage",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "dev": "CLOUDFLARE_DEV_REGISTRY_PATH=../../.wrangler/dev-registry wrangler dev",
    "deploy": "wrangler deploy --minify",
