{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ogimage",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-20",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "workers_dev": false,
  "preview_urls": false,
  "dev": {
    "port": 3002
  },
  "cache": {
    "enabled": true
  },
  "assets": {
    "directory": "./src/assets",
    "binding": "ASSETS"
  }
}
