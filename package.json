{
  "name": "official-site",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "typecheck": "turbo run check-types",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check --write . && pnpm run typecheck",
    "clean": "turbo run clean --ui=stream && pnpm exec rimraf .turbo",
    "ci": "biome ci . && pnpm run typecheck",
    "clean:all": "pnpm run clean && rm -rf node_modules apps/*/node_modules packages/*/node_modules .turbo",
    "compress:gallery": "node scripts/compress-gallery.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.11",
    "@pandacss/dev": "^1.9.0",
    "bun-types": "^1.3.11",
    "rimraf": "^6.1.3",
    "sharp": "^0.34.4",
    "turbo": "^2.8.20",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@12.9.1",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.9.1",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "24.21.0",
      "onFail": "download"
    }
  }
}
